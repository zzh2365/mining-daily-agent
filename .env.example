# Copy to .env — the agent loads it automatically (dotenv).

# ---- Orchestration mode -------------------------------------------------
# Leave the key empty to run the deterministic planner (no LLM, still a full report).
# Any OpenAI-compatible endpoint works: OpenAI, DeepSeek, Moonshot, DashScope
# compatible mode, OpenRouter, local Ollama...
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.2
# AGENT_MAX_STEPS=8

# ---- Data plane ---------------------------------------------------------
# auto (live RSS, fall back to fixtures) | live | fixture
NEWS_MODE=auto
# Optional licensed price feed: must return {"prices":[{"date":"YYYY-MM-DD","price":123}]}
# PRICE_API_URL=http://your-feed.internal/prices
# Technical-report PDF(s) to parse, comma-separated (http(s) URL, file path, or fixture:<name>)
# REPORT_PDF_URLS=fixture:pilbara_ni43101_sample

# ---- Output -------------------------------------------------------------
# AGENT_NEWS_DAYS=7
# AGENT_TREND_DAYS=30
# AGENT_MAX_ARTICLES=3
