{
  "name": "mining-daily-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mining daily-report agent built on the Model Context Protocol (3 MCP servers + 1 agent client)",
  "engines": {
    "node": ">=18.17"
  },
  "workspaces": [
    "servers/*",
    "agent"
  ],
  "scripts": {
    "validate": "node scripts/validate-mcp.mjs",
    "demo": "node agent/src/index.mjs --query \"给我生成一份关于 Pilbara 锂矿的今日简报\" --out agent/output/pilbara-report.md",
    "fixture-pdf": "node scripts/make-fixture-pdf.mjs",
    "config:client": "node scripts/gen-mcp-config.mjs --out mcp-config.client.json",
    "showcase": "node scripts/build-showcase.mjs",
    "showcase:open": "node scripts/build-showcase.mjs && start web/index.html"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "dotenv": "^16.4.5",
    "pdfjs-dist": "^3.11.174",
    "zod": "^3.25.76"
  }
}
